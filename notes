mkdir -p auto-config-pkg/DEBIAN
mkdir -p auto-config-pkg/usr/local/bin

gcc -O2 nginx-auto.c -o auto-config-pkg/usr/local/bin/auto-config
chmod +x auto-config-pkg/usr/local/bin/auto-config

nano auto-config-pkg/DEBIAN/control

  Package: auto-config
  Version: 1.0.0
  Section: utils
  Priority: optional
  Architecture: amd64
  Depends: nginx, certbot, python3-certbot-nginx
  Maintainer: sizablesplash86
  Description: Automated Nginx configuration and SSL setup generator.

dpkg-deb --build auto-config-pkg auto-config_1.0.0_amd64.deb

sudo apt install ./auto-config_1.0.0_amd64.deb


