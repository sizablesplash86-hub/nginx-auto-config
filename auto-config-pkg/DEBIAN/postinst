#!/bin/sh
set -e

HTML_DIR="/var/www/auto-config"
AVAIL_CONF="/etc/nginx/sites-available/auto-config"
ENABLED_CONF="/etc/nginx/sites-enabled/auto-config"

echo "Setting up NGINX Auto-Config Web Dashboard..."

# 1. Create the web directory
mkdir -p "$HTML_DIR"

# 2. Write out the HTML file to /var/www/auto-config/index.html
cat << 'EOF' > "$HTML_DIR/index.html"
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGINX Auto Config Generator</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --border-color: #30363d;
            --text-color: #c9d1d9;
            --accent-color: #238636;
            --accent-hover: #2ea043;
            --code-bg: #010409;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 900px;
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }

        @media (min-width: 768px) {
            .container {
                grid-template-columns: 1fr 1fr;
            }
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 20px;
        }

        h2 {
            margin-top: 0;
            font-size: 1.25rem;
            color: #58a6ff;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        input[type="text"], select {
            width: 100%;
            padding: 8px 12px;
            background-color: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: var(--text-color);
            box-sizing: border-box;
            font-size: 0.9rem;
        }

        input[type="text"]:focus, select:focus {
            outline: none;
            border-color: #58a6ff;
        }

        pre {
            background-color: var(--code-bg);
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 6px;
            overflow-x: auto;
            font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
            font-size: 0.85rem;
            line-height: 1.45;
            color: #79c0ff;
            height: 400px;
        }

        .btn-copy {
            background-color: var(--accent-color);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            width: 100%;
            margin-top: 10px;
        }

        .btn-copy:hover {
            background-color: var(--accent-hover);
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Controls Panel -->
    <div class="card">
        <h2>NGINX Config Settings</h2>
        
        <div class="form-group">
            <label for="preset">Configuration Mode</label>
            <select id="preset" onchange="toggleFields()">
                <option value="jellyfin">Preset: Jellyfin Reverse Proxy</option>
                <option value="nextcloud">Preset: Nextcloud LEMP Stack</option>
                <option value="custom_proxy">Custom: Reverse Proxy</option>
                <option value="custom_static">Custom: Static Directory</option>
            </select>
        </div>

        <div class="form-group">
            <label for="domain">Domain Name</label>
            <input type="text" id="domain" value="media.example.com" oninput="generateConfig()">
        </div>

        <div class="form-group" id="port-group">
            <label for="port">Target Port</label>
            <input type="text" id="port" value="8096" oninput="generateConfig()">
        </div>

        <div class="form-group" id="path-group" style="display: none;">
            <label for="path">Root Directory Path</label>
            <input type="text" id="path" value="/var/www/html" oninput="generateConfig()">
        </div>

        <div class="form-group" id="php-group" style="display: none;">
            <label for="phpver">PHP Socket Version</label>
            <input type="text" id="phpver" value="8.2" oninput="generateConfig()">
        </div>
    </div>

    <!-- Output Panel -->
    <div class="card">
        <h2>Generated NGINX Config</h2>
        <pre id="output"></pre>
        <button class="btn-copy" onclick="copyConfig()">Copy Configuration</button>
    </div>
</div>

<script>
function toggleFields() {
    const preset = document.getElementById('preset').value;
    const portGroup = document.getElementById('port-group');
    const pathGroup = document.getElementById('path-group');
    const phpGroup = document.getElementById('php-group');

    portGroup.style.display = 'none';
    pathGroup.style.display = 'none';
    phpGroup.style.display = 'none';

    if (preset === 'jellyfin') {
        portGroup.style.display = 'block';
        document.getElementById('port').value = '8096';
    } else if (preset === 'nextcloud') {
        phpGroup.style.display = 'block';
        pathGroup.style.display = 'block';
        document.getElementById('path').value = '/var/www/nextcloud';
    } else if (preset === 'custom_proxy') {
        portGroup.style.display = 'block';
    } else if (preset === 'custom_static') {
        pathGroup.style.display = 'block';
    }

    generateConfig();
}

function generateConfig() {
    const preset = document.getElementById('preset').value;
    const domain = document.getElementById('domain').value || 'example.com';
    const port = document.getElementById('port').value || '8080';
    const path = document.getElementById('path').value || '/var/www/html';
    const phpver = document.getElementById('phpver').value || '8.2';
    
    let config = '';

    if (preset === 'jellyfin') {
        config = `server {
    server_name ${domain};

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Protocol $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        
        # WebSockets support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}`;
    } else if (preset === 'nextcloud') {
        config = `upstream php-handler {
    server unix:/run/php/php${phpver}-fpm.sock;
}

server {
    listen 80;
    server_name ${domain};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${domain};
    root ${path};

    client_max_body_size 512M;
    client_body_timeout 300s;

    location / {
        try_files $uri $uri/ /index.php$request_uri;
    }

    location ~ \\.php$ {
        include fastcgi_params;
        fastcgi_pass php-handler;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}`;
    } else if (preset === 'custom_proxy') {
        config = `server {
    server_name ${domain};

    location / {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}`;
    } else if (preset === 'custom_static') {
        config = `server {
    server_name ${domain};
    root ${path};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }
}`;
    }

    document.getElementById('output').textContent = config;
}

function copyConfig() {
    const text = document.getElementById('output').textContent;
    navigator.clipboard.writeText(text).then(() => {
        alert('Configuration copied to clipboard!');
    });
}

// Initial render
generateConfig();
</script>

</body>
</html>
EOF

# Set ownership and permissions
chown -R www-data:www-data "$HTML_DIR"
chmod -R 755 "$HTML_DIR"

# 3. Write out the NGINX configuration file
cat << EOF > "$AVAIL_CONF"
server {
    listen 3487;

    root /var/www/auto-config/;
    index index.html;

    location / {
        autoindex on;
        try_files \$uri \$uri/ \$uri/index.html \$uri.html =404;
    }
}

EOF

# 4. Enable the site symlink if it doesn't already exist
if [ ! -f "$ENABLED_CONF" ]; then
    ln -s "$AVAIL_CONF" "$ENABLED_CONF"
fi

# 5. Reload NGINX if active to apply the new site immediately
if systemctl is-active --quiet nginx; then
    nginx -t && systemctl reload nginx
fi

exit 0
